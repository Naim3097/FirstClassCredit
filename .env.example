# ---- Payload / database ----
# Neon Postgres connection string. Use the POOLED connection string for the app.
# For migrations, Payload can use this same URL; a direct (non-pooled) URL also works.
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign Payload auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-me

# ---- Vercel Blob (Media uploads) ----
# From your Vercel project → Storage → Blob → read/write token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
